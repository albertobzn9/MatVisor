<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:VisorMat"
        x:Class="VisorMat.MainWindow"
        Title="VisorMat"
        Icon="/Assets/visormat.ico"
        Width="960"
        Height="640"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <TextBlock FontSize="28"
                 FontWeight="SemiBold"
                 Text="VisorMat" />
      <Button Grid.Column="1"
              Padding="14,8"
              Click="OpenFileButton_Click"
              Content="Abrir archivo .mat…" />
    </Grid>
    <TextBlock Grid.Row="1"
               Margin="0,6,0,20"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
               Text="Inspección rápida de matrices MATLAB, sin abrir MATLAB" />

    <Border Grid.Row="2"
            Padding="16"
            Background="{DynamicResource SystemControlHighlightAltLowBrush}"
            BorderBrush="{DynamicResource SystemControlHighlightAltAccentBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel Spacing="8">
        <TextBlock FontWeight="SemiBold" Text="Archivo" />
        <TextBlock x:Name="FilePathText"
                   FontFamily="Consolas, Menlo, monospace"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="StatusText"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border x:Name="MatrixPanel"
            Grid.Row="3"
            Margin="0,16,0,0"
            Padding="16"
            IsVisible="False"
            Background="{DynamicResource SystemControlHighlightAltLowBrush}"
            BorderBrush="{DynamicResource SystemControlHighlightAltAccentBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock x:Name="MatrixTitleText"
                   Margin="0,0,0,12"
                   FontSize="16"
                   FontWeight="SemiBold" />
        <StackPanel Grid.Row="1"
                    Margin="0,0,0,12"
                    Orientation="Horizontal"
                    Spacing="8">
          <StackPanel x:Name="ColumnModePanel"
                      IsVisible="False"
                      Orientation="Horizontal"
                      Spacing="8">
            <TextBlock x:Name="ColumnModeText"
                       VerticalAlignment="Center"
                       Text="Vista actual:" />
            <Button Click="ShowNineColumns_Click" Content="9 columnas" />
            <Button Click="ShowEightColumns_Click" Content="8 columnas" />
            <Button x:Name="SaveEightColumnsButton"
                    Click="SaveEightColumns_Click"
                    Content="Guardar matriz de 8 columnas…"
                    IsVisible="False" />
          </StackPanel>
          <Button x:Name="GenerateAnalysisButton"
                  Click="GenerateAnalysis_Click"
                  Content="Generar análisis (cols. 9–12)"
                  IsVisible="False" />
        </StackPanel>
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
          <local:MatrixTable x:Name="MatrixTable" />
        </ScrollViewer>
        <StackPanel x:Name="ZoomPanel"
                    Grid.Row="3"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    IsVisible="False"
                    Orientation="Horizontal"
                    Spacing="4">
          <Button Click="ZoomOut_Click" Content="− Zoom" />
          <TextBlock x:Name="ZoomText"
                     VerticalAlignment="Center"
                     Text="100%" />
          <Button Click="ZoomIn_Click" Content="+ Zoom" />
          <Button Click="ResetZoom_Click" Content="Restablecer" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
