<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MatVisor"
        x:Class="MatVisor.MainWindow"
        Title="MatVisor"
        Icon="/Assets/matvisor.ico"
        Width="960"
        Height="640"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
      <TextBlock FontSize="28"
                 FontWeight="SemiBold"
                 Text="MatVisor" />
      <Button x:Name="OpenFileButton"
              Grid.Column="1"
              Margin="0,0,8,0"
              Padding="14,8"
              Click="OpenFileButton_Click" />
      <ToggleButton x:Name="LanguageToggleButton"
                    Grid.Column="2"
                    Padding="12,8"
                    IsCheckedChanged="LanguageToggleButton_IsCheckedChanged">
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
          <TextBlock x:Name="EnglishLanguageText" Text="Eng" />
          <TextBlock x:Name="SpanishLanguageText" Grid.Column="1" Text="Esp" />
        </Grid>
      </ToggleButton>
    </Grid>
    <TextBlock x:Name="SubtitleText"
               Grid.Row="1"
               Margin="0,6,0,20"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

    <Border Grid.Row="2"
            Padding="16"
            Background="{DynamicResource SystemControlHighlightAltLowBrush}"
            BorderBrush="{DynamicResource SystemControlHighlightAltAccentBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel Spacing="8">
        <TextBlock x:Name="FileLabelText" FontWeight="SemiBold" />
        <TextBlock x:Name="FilePathText"
                   FontFamily="Consolas, Menlo, monospace"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="StatusText"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border x:Name="MatrixPanel"
            Grid.Row="3"
            Margin="0,16,0,0"
            Padding="16"
            IsVisible="False"
            Background="{DynamicResource SystemControlHighlightAltLowBrush}"
            BorderBrush="{DynamicResource SystemControlHighlightAltAccentBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock x:Name="MatrixTitleText"
                   Margin="0,0,0,12"
                   FontSize="16"
                   FontWeight="SemiBold" />
        <StackPanel Grid.Row="1"
                    Margin="0,0,0,12"
                    Orientation="Horizontal"
                    Spacing="8">
          <StackPanel x:Name="ColumnModePanel"
                      IsVisible="False"
                      Orientation="Horizontal"
                      Spacing="8">
            <TextBlock x:Name="ColumnModeText"
                       VerticalAlignment="Center"
                       Text="" />
            <Button x:Name="ShowNineColumnsButton" Click="ShowNineColumns_Click" />
            <Button x:Name="ShowEightColumnsButton" Click="ShowEightColumns_Click" />
            <Button x:Name="SaveEightColumnsButton"
                    Click="SaveEightColumns_Click"
                    IsVisible="False" />
          </StackPanel>
          <Button x:Name="GenerateAnalysisButton"
                  Click="GenerateAnalysis_Click"
                  IsVisible="False" />
        </StackPanel>
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
          <local:MatrixTable x:Name="MatrixTable" />
        </ScrollViewer>
        <StackPanel x:Name="ZoomPanel"
                    Grid.Row="3"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    IsVisible="False"
                    Orientation="Horizontal"
                    Spacing="4">
          <Button x:Name="ZoomOutButton" Click="ZoomOut_Click" />
          <TextBlock x:Name="ZoomText"
                     VerticalAlignment="Center"
                     Text="100%" />
          <Button x:Name="ZoomInButton" Click="ZoomIn_Click" />
          <Button x:Name="ResetZoomButton" Click="ResetZoom_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
