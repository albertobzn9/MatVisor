<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MatVisor"
        x:Class="MatVisor.AnalysisWindow"
        Title="MatVisor"
        Icon="/Assets/matvisor.ico"
        Width="620"
        Height="720"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Spacing="4">
      <TextBlock x:Name="AnalysisTitleText"
                 FontSize="24"
                 FontWeight="SemiBold" />
      <TextBlock x:Name="SourceText"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 TextWrapping="Wrap" />
    </StackPanel>
    <Border Grid.Row="1"
            Margin="0,16"
            Padding="12"
            Background="{DynamicResource SystemControlHighlightAltLowBrush}"
            BorderBrush="{DynamicResource SystemControlHighlightAltAccentBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <TextBlock x:Name="AnalysisDescriptionText" TextWrapping="Wrap" />
    </Border>
    <ScrollViewer Grid.Row="2"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
      <local:MatrixTable x:Name="AnalysisTable" />
    </ScrollViewer>
    <StackPanel Grid.Row="3"
                Margin="0,12,0,0"
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="6">
      <Button x:Name="ZoomOutButton" Click="ZoomOut_Click" />
      <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Text="100%" />
      <Button x:Name="ZoomInButton" Click="ZoomIn_Click" />
      <Button x:Name="ResetZoomButton" Click="ResetZoom_Click" />
    </StackPanel>
  </Grid>
</Window>
